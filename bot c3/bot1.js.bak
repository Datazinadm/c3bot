// ============================================================
// COMANDO /start
// ============================================================
bot.start(async (ctx) => {
    await ctx.replyWithHTML(
        '☢️ <b>C3 CONSULTORIA</b>\n\n' +
        '📌 <b>Comandos disponíveis:</b>\n\n' +
        '🔹 <b>Dados Pessoais:</b>\n' +
        '/cpf [CPF] - Consultar CPF (com opções)\n' +
        '/rg [RG] - Consultar RG (com opções)\n' +
        '/telefone [TELEFONE] - Consultar Telefone (com opções)\n' +
        '/email [EMAIL] - Consultar Email\n' +
        '/parentes [CPF] - Buscar parentes\n' +
        '/nome [NOME] - Buscar por nome\n\n' +
        '🔹 <b>Filiação:</b>\n' +
        '/mae [NOME] - Buscar por nome da mãe\n' +
        '/pai [NOME] - Buscar por nome do pai\n\n' +
        '🔹 <b>Documentos:</b>\n' +
        '/doc [DOC] - Consultar documento\n' +
        '/nome1 [NOME] - Buscar nome (SPC)\n' +
        '/telefone2 [TELEFONE] - Buscar telefone (SPC)\n\n' +
        '🔹 <b>Endereço:</b>\n' +
        '/cep [CEP] - Consultar CEP\n' +
        '/telefone3 [TELEFONE] - Buscar telefone (TEL)\n' +
        '/cpftel [CPF] - Buscar CPF + Telefone\n\n' +
        '🔹 <b>Empresarial:</b>\n' +
        '/cnpj [CNPJ] - Consultar CNPJ\n\n' +
        '<b>Exemplo:</b>\n' +
        '<code>/cpf 12345678900</code>'
    );
});

// ============================================================
// COMANDO /help
