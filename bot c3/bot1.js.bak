// ============================================================
// COMANDO /doc
// ============================================================
bot.command('doc', async (ctx) => {
    const args = ctx.message.text.split(' ');
    if (args.length < 2) {
        return ctx.replyWithHTML('❌ <b>Uso:</b>\n<code>/doc 00021775176215</code>');
    }
    const query = args[1];
    const result = await consultarAPI('/spc1.php', query, 'doc');
    if (result.success) {
        const dados = extrairDadosImportantes(result.data);
        await enviarResposta(ctx, dados, 'documento', query, ctx.from.first_name);
    } else {
        await ctx.replyWithHTML(result.error);
    }
});

// ============================================================
// COMANDO /nome1
// ============================================================
bot.command('nome1', async (ctx) => {
    const args = ctx.message.text.split(' ');
    if (args.length < 2) {
        return ctx.replyWithHTML('❌ <b>Uso:</b>\n<code>/nome1 NOME COMPLETO</code>');
    }
    const query = encodeURIComponent(args.slice(1).join(' '));
    const result = await consultarAPI('/spc1.php', query, 'nome');
    if (result.success) {
        const dados = extrairDadosImportantes(result.data);
        await enviarResposta(ctx, dados, 'nome (SPC)', args.slice(1).join(' '), ctx.from.first_name);
    } else {
        await ctx.replyWithHTML(result.error);
    }
});

