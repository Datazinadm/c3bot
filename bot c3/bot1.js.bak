    }
    const query = args[1].replace(/\D/g, '');
    const result = await consultarAPI('/spc1.php', query, 'telefone');
    if (result.success) {
        const dados = extrairDadosImportantes(result.data);
        await enviarResposta(ctx, dados, 'telefone (SPC)', query, ctx.from.first_name);
    } else {
        await ctx.replyWithHTML(result.error);
    }
});

