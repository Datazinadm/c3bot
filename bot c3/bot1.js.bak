bot.command('help', async (ctx) => {
    await ctx.replyWithHTML(
        '☢️ <b>C3 CONSULTORIA - AJUDA</b>\n\n' +
        '📌 <b>Comandos:</b>\n\n' +
        '/cpf [CPF] - Consultar CPF (Serasa/Simples)\n' +
        '/rg [RG] - Consultar RG (com foto/Serasa)\n' +
        '/telefone [TELEFONE] - Consultar Telefone (Serasa/Simples)\n' +
        '/email [EMAIL] - Consultar Email\n' +
        '/parentes [CPF] - Buscar parentes\n' +
        '/nome [NOME] - Buscar por nome\n' +
        '/mae [NOME] - Buscar por nome da mãe\n' +
        '/pai [NOME] - Buscar por nome do pai\n' +
        '/doc [DOC] - Consultar documento\n' +
        '/nome1 [NOME] - Buscar nome (SPC)\n' +
        '/telefone2 [TELEFONE] - Buscar telefone (SPC)\n' +
        '/cep [CEP] - Consultar CEP\n' +
        '/telefone3 [TELEFONE] - Buscar telefone (TEL)\n' +
        '/cpftel [CPF] - Buscar CPF + Telefone\n' +
        '/cnpj [CNPJ] - Consultar CNPJ\n\n' +
        '<b>Exemplos:</b>\n' +
        '<code>/cpf 12345678900</code>\n' +
        '<code>/mae MARIA SILVA</code>\n' +
        '<code>/cnpj 12345678000199</code>'
    );
});

// ============================================================
// INICIAR BOT
// ============================================================
bot.launch({
    dropPendingUpdates: true
}).then(() => {
    console.log('════════════════════════════════════════════════');
    console.log('☢️ C3 CONSULTORIA - BOT');
    console.log('════════════════════════════════════════════════');
    console.log('✅ Bot iniciado!');
    console.log('📌 Comandos disponíveis:');
    console.log('   /cpf, /rg, /telefone, /email, /parentes');
    console.log('   /nome, /mae, /pai, /doc, /nome1');
    console.log('   /telefone2, /cep, /telefone3, /cpftel');
    console.log('   /cnpj');
    console.log('════════════════════════════════════════════════');
}).catch(e => {
    console.error('❌ Erro:', e.message);
});

// ============================================================
// SHUTDOWN
// ============================================================
process.on('SIGINT', () => {
    console.log('\n👋 Encerrando...');
    bot.stop('SIGINT');
    process.exit(0);
});