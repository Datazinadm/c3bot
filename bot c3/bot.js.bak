    );
    
    await sendLogToAdmin(
        `🗑️ PADRÃO REMOVIDO\n` +
        `👤 ${count} usuários restaurados`
    );
});


bot.command('node', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!isAdmin(userId)) {
        return ctx.reply('🚫 ACESSO BLOQUEADO');
    }
    
    let msg = ctx.message.text.replace('/node', '').trim();
    if (!msg) {
        return ctx.reply('📢 /node [MSG]\nEx: /node Manutenção às 22h');
    }
    

    const repliedMsg = ctx.message.reply_to_message;
    let targetUserId = null;
    
    if (repliedMsg && repliedMsg.from) {
        targetUserId = repliedMsg.from.id.toString();
        msg = repliedMsg.text || 'Mensagem sem texto';
    }
    
    let sent = 0;
    let errors = 0;
    
    if (targetUserId) {
        
        try {
            await bot.telegram.sendMessage(
                targetUserId,
                `📩 <b>MENSAGEM DO ADM</b>\n\n${msg}`,
                { parse_mode: 'HTML' }
            );
            sent = 1;
        } catch(e) {
            errors = 1;
        }
        
        await ctx.replyWithHTML(
            `📩 <b>MENSAGEM ENVIADA</b>\n\n` +
            `👤 Usuário: ${targetUserId}\n` +
            `✅ ${sent > 0 ? 'Enviado com sucesso!' : '❌ Erro ao enviar'}`
        );
    } else {
        // Envia para todos os usuários
        for (const [id, user] of authorizedUsers) {
            try {
                await bot.telegram.sendMessage(
                    id,
                    `📢 <b>AVISO DO ADMIN</b>\n\n${msg}`,
                    { parse_mode: 'HTML' }
                );
                sent++;
                await new Promise(r => setTimeout(r, 50));
            } catch(e) {
                errors++;
            }
        }
        
        await ctx.replyWithHTML(
            `📢 <b>AVISO ENVIADO!</b>\n\n` +
            `✅ ${sent} usuários\n` +
            `❌ ${errors} erros`
        );
    }
});


bot.command('adm', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!isDono(userId)) {
        return ctx.reply('🚫 APENAS O DONO');
    }
    
    const args = ctx.message.text.split(' ');
    if (args.length < 2) {
        return ctx.reply('/adm [ID]\nEx: /adm 123456789');
    }
    
    const targetId = args[1].trim();
    if (!/^\d+$/.test(targetId)) return ctx.reply('❌ ID INVALIDO');
    
    if (isAdmin(targetId)) {
        return ctx.reply('❌ JÁ É ADMIN');
    }
    
    adminList.add(targetId);
    saveAdmins();
    
    if (!authorizedUsers.has(targetId)) {
        authorizedUsers.set(targetId, {
            limit: 999, currentAttacks: 0, maxTime: GLOBAL_MAX_TIME,
            maxRps: GLOBAL_MAX_RPS, maxThreads: GLOBAL_MAX_THREADS, simultaneousLimit: 999,
            patente: 'ADMIN', plano: 'VITALICIO', vip: true,
            total_attacks: 0, total_quedas: 0,
            first_name: '', username: '',
            added_by: DONO_ID, added_at: Date.now()
        });
    } else {
        const user = authorizedUsers.get(targetId);
        user.vip = true;
        user.patente = 'ADMIN';
        user.plano = 'VITALICIO';
        user.simultaneousLimit = 999;
        user.maxTime = GLOBAL_MAX_TIME;
        user.limit = 999;
    }
    saveUsers();
    
    await ctx.reply('✅ ADMIN ADICIONADO: ' + targetId);
    
    try {
        await bot.telegram.sendMessage(targetId,
            '🎉 VOCÊ FOI PROMOVIDO A ADMIN!\n\n' +
            'Use /start para ver os comandos.'
        );
    } catch(e) {}
    
    await sendLogToAdmin('👑 NOVO ADMIN: ' + targetId);
});


bot.command('removeadm', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!isDono(userId)) {
        return ctx.reply('🚫 APENAS O DONO');
    }
    
    const args = ctx.message.text.split(' ');
    if (args.length < 2) {
        return ctx.reply('/removeadm [ID]');
    }
    
    const targetId = args[1].trim();
    if (isDono(targetId)) return ctx.reply('❌ NÃO PODE REMOVER O DONO');
    if (!adminList.has(targetId)) return ctx.reply('❌ NÃO É ADMIN');
    
    adminList.delete(targetId);
    saveAdmins();
    
    const user = authorizedUsers.get(targetId);
    if (user) {
        user.patente = 'PADRAO';
        user.plano = 'GRATUITO';
        user.vip = false;
        user.simultaneousLimit = 1;
        user.maxTime = 30;
        user.limit = 1;
        saveUsers();
    }
    
    await ctx.reply('✅ ADMIN REMOVIDO: ' + targetId);
});


bot.command('listadmins', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!isAdmin(userId)) {
        return ctx.reply('🚫 ACESSO BLOQUEADO');
    }
    
    let msg = '👑 ADMINISTRADORES\n\n';
    msg += '👑 DONO: ' + DONO_ID + '\n';
    msg += '━━━━━━━━━━━━━━━━━━━━\n';
    
    let count = 0;
    for (const adminId of adminList) {
        if (adminId === DONO_ID) continue;
        count++;
        const user = authorizedUsers.get(adminId);
        const name = user?.first_name || 'Desconhecido';
        msg += count + '. ' + adminId + ' - ' + name + '\n';
    }
    
    if (count === 0) msg += 'Nenhum admin adicional.\n';
    msg += '\n📊 Total: 1 DONO + ' + count + ' ADMINS';
    
    await ctx.reply(msg);
});


bot.command('gerakey', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!isAdmin(userId)) {
        return ctx.reply('🚫 ACESSO BLOQUEADO');
    }
    
    const args = ctx.message.text.split(' ');
    if (args.length < 4) {
        return ctx.reply(
            '🔑 /gerakey [SIM] [TEMPO] [DUR]\n' +
            'Ex: /gerakey 1 120 1d\n' +
            'Formatos: d, h, m'
        );
    }
    
    const sim = parseInt(args[1]);
    const maxTime = parseInt(args[2]);
    const duracaoStr = args[3].toLowerCase();
    
    if (isNaN(sim) || sim < 1) return ctx.reply('❌ SIM INVALIDO');
    if (isNaN(maxTime) || maxTime < 10) return ctx.reply('❌ TEMPO INVALIDO');
    
    let durationSeconds = 0;
    let durationText = '';
    
    if (duracaoStr.endsWith('d')) {
        const val = parseInt(duracaoStr);
        if (isNaN(val) || val < 1) return ctx.reply('❌ DIAS INVALIDOS');
        durationSeconds = val * 86400;
        durationText = val + ' dia(s)';
    } else if (duracaoStr.endsWith('h')) {
        const val = parseInt(duracaoStr);
        if (isNaN(val) || val < 1) return ctx.reply('❌ HORAS INVALIDAS');
        durationSeconds = val * 3600;
        durationText = val + ' hora(s)';
    } else if (duracaoStr.endsWith('m')) {
        const val = parseInt(duracaoStr);
        if (isNaN(val) || val < 1) return ctx.reply('❌ MINUTOS INVALIDOS');
        durationSeconds = val * 60;
        durationText = val + ' minuto(s)';
    } else {
        return ctx.reply('❌ FORMATO INVALIDO! Use: 1d, 1h ou 1m');
    }
    
    if (durationSeconds < 60) return ctx.reply('❌ DURAÇÃO MÍNIMA: 1 MINUTO');
    
    const key = 'c3-' + Date.now().toString(36) + '-' + Math.random().toString(36).substring(2, 8);
    const expiresAt = Math.floor(Date.now() / 1000) + durationSeconds;
    
    apiKeys.set(key, {
        user_id: userId,
        created_at: Math.floor(Date.now() / 1000),
        expires_at: expiresAt,
        duration: durationSeconds,
        simultaneous: sim,
        max_time: maxTime,
        active: true,
        created_by_name: ctx.from.first_name || 'ADMIN',
        created_by_id: userId
    });
    
    saveApiKeys();
    
    await ctx.reply(
        '✅ KEY GERADA\n\n' +
        '🔑 ' + key + '\n' +
        '🔄 ' + sim + 'x | ⏱️ ' + maxTime + 's\n' +
        '⏳ ' + durationText
    );
});


bot.command('listkeys', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!isAdmin(userId)) {
        return ctx.reply('🚫 ACESSO BLOQUEADO');
    }
    
    if (apiKeys.size === 0) {
        return ctx.reply('📋 NENHUMA KEY CADASTRADA');
    }
    
    let msg = '🔑 API KEYS\n\n';
    let count = 0;
    const now = Math.floor(Date.now() / 1000);
    
    for (const [key, data] of apiKeys) {
        count++;
        const remaining = Math.max(0, (data.expires_at || 0) - now);
        const status = data.active && remaining > 0 ? '✅ ATIVA' : '❌ EXPIRADA';
        
        msg += '#' + count + ': ' + key + '\n';
        msg += '   Status: ' + status + '\n';
        msg += '   Simul: ' + (data.simultaneous || 'N/A') + '\n';
        msg += '   Tempo: ' + (data.max_time || 'N/A') + 's\n\n';
        
        if (msg.length > 3500) {
            await ctx.reply(msg);
            msg = '';
        }
    }
    
    if (msg) {
        msg += '━━━━━━━━━━━━━━━━━━━━\n';
        msg += 'Total: ' + apiKeys.size + ' keys';
        await ctx.reply(msg);
    }
});


bot.command('revoke', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!isAdmin(userId)) {
        return ctx.reply('🚫 ACESSO BLOQUEADO');
    }
    
    const args = ctx.message.text.split(' ');
    if (args.length < 2) {
        return ctx.reply('/revoke [KEY]');
    }
    
    const key = args[1];
    
    if (apiKeys.has(key)) {
        const keyData = apiKeys.get(key);
        keyData.active = false;
        keyData.revoked_at = Math.floor(Date.now() / 1000);
        keyData.revoked_by = userId;
        saveApiKeys();
        
        await ctx.reply('✅ KEY REVOGADA: ' + key);
        await sendLogToAdmin('🗑️ KEY REVOGADA: ' + key);
    } else {
        await ctx.reply('❌ KEY NÃO ENCONTRADA');
    }
});


bot.command('addvip', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!isAdmin(userId)) {
        return ctx.reply('🚫 ACESSO BLOQUEADO');
    }
    
    const args = ctx.message.text.split(' ');
    if (args.length < 5) {
        return ctx.reply(
            '👑 /addvip [ID] [SIM] [TEMPO] [DUR]\n' +
            'Ex: /addvip 123456789 5 300 1d'
        );
    }
    
    const targetId = args[1];
    const sim = parseInt(args[2]);
    const tmax = parseInt(args[3]);
    const duracaoStr = args[4].toLowerCase();
    
    if (isNaN(sim) || sim < 1) return ctx.reply('❌ SIM INVALIDO');
    if (isNaN(tmax) || tmax < 10) return ctx.reply('❌ TEMPO INVALIDO');
    
    let durationSeconds = 0;
    let durationText = '';
    
    if (duracaoStr.endsWith('d')) {
        const val = parseInt(duracaoStr);
        if (isNaN(val) || val < 1) return ctx.reply('❌ DIAS INVALIDOS');
        durationSeconds = val * 86400;
        durationText = val + ' dia(s)';
    } else if (duracaoStr.endsWith('h')) {
        const val = parseInt(duracaoStr);
        if (isNaN(val) || val < 1) return ctx.reply('❌ HORAS INVALIDAS');
        durationSeconds = val * 3600;
        durationText = val + ' hora(s)';
    } else if (duracaoStr.endsWith('m')) {
        const val = parseInt(duracaoStr);
        if (isNaN(val) || val < 1) return ctx.reply('❌ MINUTOS INVALIDOS');
        durationSeconds = val * 60;
        durationText = val + ' minuto(s)';
    } else {
        return ctx.reply('❌ FORMATO INVALIDO! Use: 1d, 1h ou 1m');
    }
    
    const existingUser = authorizedUsers.get(targetId);
    
    vipUsers.set(targetId, {
        simultaneous: sim,
        maxTime: tmax,
        expires_at: Date.now() + (durationSeconds * 1000),
        added_by: userId,
        added_at: Date.now()
    });
    saveVips();
    
    if (!authorizedUsers.has(targetId)) {
        authorizedUsers.set(targetId, {
            limit: sim,
            currentAttacks: 0,
            maxTime: tmax,
            maxRps: GLOBAL_MAX_RPS,
            maxThreads: GLOBAL_MAX_THREADS,
            simultaneousLimit: sim,
            patente: 'ELITE',
            plano: 'MENSAL',
            vip: true,
            total_attacks: 0,
            total_quedas: 0,
            first_name: '',
            username: '',
            added_by: userId,
            added_at: Date.now()
        });
    } else {
        const user = authorizedUsers.get(targetId);
        user.vip = true;
        user.patente = 'ELITE';
        user.plano = 'MENSAL';
        user.simultaneousLimit = sim;
        user.maxTime = tmax;
        user.limit = sim;
    }
    saveUsers();
    
    await ctx.reply('✅ VIP ADICIONADO: ' + targetId + '\n🔄 ' + sim + 'x | ⏱️ ' + tmax + 's\n⏳ ' + durationText);
    
    try {
        await bot.telegram.sendMessage(targetId,
            '🎉 VOCÊ FOI PROMOVIDO A VIP!\n\n' +
            '🔄 ' + sim + 'x | ⏱️ ' + tmax + 's\n' +
            '⏳ ' + durationText + '\n\n' +
            'Use /attack para começar!'
        );
    } catch(e) {}
});


bot.command('removevip', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!isAdmin(userId)) {
        return ctx.reply('🚫 ACESSO BLOQUEADO');
    }
    
    const args = ctx.message.text.split(' ');
    if (args.length < 2) {
        return ctx.reply('/removevip [ID]');
    }
    
    const targetId = args[1];
    
    if (vipUsers.has(targetId)) {
        vipUsers.delete(targetId);
        saveVips();
    }
    
    const user = authorizedUsers.get(targetId);
    if (user) {
        user.vip = false;
        user.patente = 'PADRAO';
        user.plano = 'GRATUITO';
        user.simultaneousLimit = 1;
        user.maxTime = 30;
        user.limit = 1;
        saveUsers();
    }
    
    await ctx.reply('✅ VIP REMOVIDO: ' + targetId);
});


bot.command('listvip', async (ctx) => {
    const userId = ctx.from.id.toString();
    
