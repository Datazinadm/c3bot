function checkVipExpiration(userId) {
    const vipData = vipUsers.get(userId);
    if (!vipData) return false;
    
    if (vipData.expires_at && Date.now() > vipData.expires_at) {
        vipUsers.delete(userId);
        saveVips();
        
        const user = authorizedUsers.get(userId);
        if (user) {
            user.vip = false;
            user.patente = 'PADRAO';
            user.plano = 'GRATUITO';
            user.simultaneousLimit = 1;
            user.maxTime = 30;
            user.limit = 1;
            saveUsers();
        }
        return false;
    }
    
    return true;
}

function getVipRemaining(userId) {
    const vipData = vipUsers.get(userId);
    if (!vipData || !vipData.expires_at) return 0;
    return Math.max(0, vipData.expires_at - Date.now());
}

function formatVipRemaining(ms) {
    const seconds = Math.floor(ms / 1000);
    const days = Math.floor(seconds / 86400);
    const hours = Math.floor((seconds % 86400) / 3600);
    const minutes = Math.floor((seconds % 3600) / 60);
    
    if (days > 0) return `${days}d ${hours}h`;
    if (hours > 0) return `${hours}h ${minutes}m`;
    return `${minutes}m`;
}


function checkDefaultConfigExpiration() {
    if (defaultConfig.expires_at > 0 && Date.now() > defaultConfig.expires_at) {
        defaultConfig = { simultaneous: 1, maxTime: 30, expires_at: 0 };
        saveDefaultConfig();
        
        for (const [id, user] of authorizedUsers) {
            if (!isAdmin(id) && !user.vip) {
                user.simultaneousLimit = 1;
                user.maxTime = 30;
                user.limit = 1;
                user.patente = 'PADRAO';
                user.plano = 'GRATUITO';
            }
        }
        saveUsers();
        return false;
    }
    return true;
}


function checkSiteWithCurl(target) {
    return new Promise((resolve) => {
        const url = target.startsWith('http') ? target : `https://${target}`;
        
        exec(`curl -s -o /dev/null -w "%{http_code}" --connect-timeout 5 --max-time 10 "${url}"`, (error, stdout, stderr) => {
            const httpCode = stdout.trim();
            
            if (error || httpCode === '000' || httpCode === '522' || httpCode === '524' || httpCode === '502' || httpCode === '503' || httpCode === '504') {
                let errorMsg = '';
                if (httpCode === '522') errorMsg = 'Connection timed out';
                else if (httpCode === '524') errorMsg = 'Timeout';
                else if (httpCode === '502') errorMsg = 'Bad Gateway';
                else if (httpCode === '503') errorMsg = 'Service Unavailable';
                else if (httpCode === '504') errorMsg = 'Gateway Timeout';
                else if (httpCode === '000') errorMsg = 'Sem resposta';
                else errorMsg = stderr || 'Erro desconhecido';
                
                resolve({
                    online: false,
                    status: '💀 MORTO',
                    error: `Erro: ${httpCode} - ${errorMsg}`,
                    httpCode: httpCode
                });
            } else if (httpCode >= 200 && httpCode < 400) {
                resolve({
                    online: true,
                    status: '🟢 ONLINE',
                    error: null,
                    httpCode: httpCode
                });
            } else {
                resolve({
                    online: false,
                    status: '🔴 MORTO',
                    error: `Erro: ${httpCode}`,
                    httpCode: httpCode
                });
            }
        });
    });
}


