    await ctx.reply(msg);
});


bot.command('clearhistory', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!isAdmin(userId)) {
        return ctx.reply('🚫 ACESSO BLOQUEADO');
    }
    
    const args = ctx.message.text.split(' ');
    if (args.length < 2) {
        return ctx.reply('/clearhistory [ID/all]');
    }
    
    const target = args[1];
    
    if (target === 'all') {
        userAttackHistory.clear();
        saveAttackHistory();
        authorizedUsers.forEach(user => { user.total_attacks = 0; user.total_quedas = 0; });
        saveUsers();
        await ctx.reply('✅ TODO HISTORICO LIMPO');
    } else {
        if (userAttackHistory.has(target)) {
            userAttackHistory.delete(target);
            saveAttackHistory();
            const user = authorizedUsers.get(target);
            if (user) { user.total_attacks = 0; user.total_quedas = 0; saveUsers(); }
            await ctx.reply('✅ HISTORICO DE ' + target + ' LIMPO');
        } else {
            await ctx.reply('❌ USUARIO NAO ENCONTRADO');
        }
    }
});


