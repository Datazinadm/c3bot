function isAdmin(userId) {
    const id = userId.toString();
    return id === DONO_ID || adminList.has(id);
}

function isDono(userId) {
    return userId.toString() === DONO_ID;
}

function escapeMarkdown(text) {
    if (!text) return '';
    return String(text).replace(/[_*[\]()~`>#+\-=|{}.!]/g, '\\$&');
}

function formatTimeAgo(timestamp) {
    const now = Date.now();
    const diff = now - timestamp;
    const seconds = Math.floor(diff / 1000);
    const minutes = Math.floor(seconds / 60);
    const hours = Math.floor(minutes / 60);
    const days = Math.floor(hours / 24);
    
    if (days > 0) return days + 'd atras';
    if (hours > 0) return hours + 'h atras';
    if (minutes > 0) return minutes + 'min atras';
    return seconds + 's atras';
}

function parseDuration(durationStr) {
    const str = durationStr.toLowerCase();
    let seconds = 0;
    let text = '';
    
    if (str.endsWith('d')) {
        const val = parseInt(str);
        if (isNaN(val) || val < 1) return null;
        seconds = val * 86400;
        text = val + ' dia(s)';
    } else if (str.endsWith('h')) {
        const val = parseInt(str);
        if (isNaN(val) || val < 1) return null;
        seconds = val * 3600;
        text = val + ' hora(s)';
    } else if (str.endsWith('m')) {
        const val = parseInt(str);
        if (isNaN(val) || val < 1) return null;
        seconds = val * 60;
        text = val + ' minuto(s)';
    } else {
        return null;
    }
    
    return { seconds, text };
}


function loadData() {
    try {
        if (fs.existsSync(USERS_FILE)) {
            const users = JSON.parse(fs.readFileSync(USERS_FILE, 'utf8'));
            Object.entries(users).forEach(([id, data]) => {
                authorizedUsers.set(id, { ...data, currentAttacks: data.currentAttacks || 0 });
            });
        }
        if (fs.existsSync(BLOCKED_FILE)) {
            const targets = JSON.parse(fs.readFileSync(BLOCKED_FILE, 'utf8'));
            targets.forEach(t => blockedTargets.add(t));
        }
        if (fs.existsSync(STATS_FILE)) {
            globalStats = JSON.parse(fs.readFileSync(STATS_FILE, 'utf8'));
        }
        if (fs.existsSync(ADMINS_FILE)) {
            const admins = JSON.parse(fs.readFileSync(ADMINS_FILE, 'utf8'));
            adminList.clear();
            admins.forEach(id => adminList.add(id.toString()));
        }
        if (fs.existsSync(VIP_FILE)) {
            const vips = JSON.parse(fs.readFileSync(VIP_FILE, 'utf8'));
            vipUsers.clear();
            Object.entries(vips).forEach(([id, data]) => {
                vipUsers.set(id, data);
            });
        }
        if (fs.existsSync(API_KEYS_FILE)) {
            const keys = JSON.parse(fs.readFileSync(API_KEYS_FILE, 'utf8'));
            apiKeys.clear();
            Object.entries(keys).forEach(([key, data]) => {
                apiKeys.set(key, data);
            });
        }
        if (fs.existsSync(ATTACK_HISTORY_FILE)) {
            const history = JSON.parse(fs.readFileSync(ATTACK_HISTORY_FILE, 'utf8'));
            Object.entries(history).forEach(([userId, data]) => {
                userAttackHistory.set(userId, data);
            });
        }
        if (fs.existsSync(DEFAULT_CONFIG_FILE)) {
            defaultConfig = JSON.parse(fs.readFileSync(DEFAULT_CONFIG_FILE, 'utf8'));
        }
    } catch(e) { console.error('ERRO AO CARREGAR:', e); }
    
    adminList.add(DONO_ID);
    saveAdmins();
    
    if (!authorizedUsers.has(DONO_ID)) {
        authorizedUsers.set(DONO_ID, { 
            limit: 999, currentAttacks: 0, maxTime: GLOBAL_MAX_TIME,
            maxRps: GLOBAL_MAX_RPS, maxThreads: GLOBAL_MAX_THREADS, simultaneousLimit: 999,
            patente: 'DONO', plano: 'VITALICIO', vip: true,
            total_attacks: 0, total_quedas: 0,
            first_name: 'DONO', username: 'dono'
        });
        saveUsers();
    }
}

function saveUsers() {
    const users = {};
    authorizedUsers.forEach((v, k) => { users[k] = v; });
    fs.writeFileSync(USERS_FILE, JSON.stringify(users, null, 2));
}

function saveBlocked() {
    fs.writeFileSync(BLOCKED_FILE, JSON.stringify([...blockedTargets], null, 2));
}

function saveStats() {
    fs.writeFileSync(STATS_FILE, JSON.stringify(globalStats, null, 2));
}

function saveAdmins() {
    const admins = Array.from(adminList);
    fs.writeFileSync(ADMINS_FILE, JSON.stringify(admins, null, 2));
}

function saveVips() {
