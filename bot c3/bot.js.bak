process.on('SIGINT', () => {
    console.log('\n🛑 FINALIZANDO...');
    saveApiKeys();
    saveUsers();
    saveBlocked();
    saveStats();
    saveAttackHistory();
    saveAdmins();
    saveVips();
    saveDefaultConfig();
    for (const [id, attack] of activeAttacks) {
        if (attack.timerTimeout) clearTimeout(attack.timerTimeout);
        if (attack.statusInterval) clearInterval(attack.statusInterval);
        if (attack.processes) {
            attack.processes.forEach(p => { try { killProcessTree(p.pid); } catch(e) {} });
        }
    }
    process.exit(0);
});
