});


bot.command('rank', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!checkCaptcha(userId)) {
        await showCaptcha(ctx, userId);
        return;
    }
    
    const rankingData = [];
    
    userAttackHistory.forEach((history, uid) => {
        const user = authorizedUsers.get(uid);
        if (user && user.vip) {
            rankingData.push({
                id: uid,
                name: history.first_name || 'VIP-' + uid.substring(0, 6),
                total_attacks: history.total_attacks || 0,
                total_quedas: history.total_quedas || 0,
                last_attack: history.last_attack || 0,
                patente: user.patente || 'VIP',
                simultaneousLimit: user.simultaneousLimit || 0,
                maxTime: user.maxTime || 0
            });
        }
    });
    
    authorizedUsers.forEach((user, uid) => {
        if (user.vip && !rankingData.find(r => r.id === uid)) {
            rankingData.push({
                id: uid,
                name: user.first_name || 'VIP-' + uid.substring(0, 6),
                total_attacks: user.total_attacks || 0,
                total_quedas: user.total_quedas || 0,
                last_attack: 0,
                patente: user.patente || 'VIP',
                simultaneousLimit: user.simultaneousLimit || 0,
                maxTime: user.maxTime || 0
            });
        }
    });
    
    rankingData.sort((a, b) => b.total_attacks - a.total_attacks);
    
    if (rankingData.length === 0) {
        return ctx.reply('🏆 RANKING VIP\n\n📊 Nenhum operador VIP registrou ataques ainda.');
    }
    
    let msg = '🏆 <b>RANKING VIP</b>\n\n';
    
    const medals = ['🥇', '🥈', '🥉', '4️⃣', '5️⃣', '6️⃣', '7️⃣', '8️⃣', '9️⃣', '🔟'];
    
    rankingData.slice(0, 10).forEach((entry, index) => {
        const medal = medals[index] || '📌';
        const lastAttackTime = entry.last_attack > 0 
            ? formatTimeAgo(entry.last_attack)
            : 'Nenhum ataque';
        
        msg += medal + ' ' + entry.name + '\n';
        msg += '   ⚔️ ' + entry.total_attacks + ' | 💀 ' + entry.total_quedas + '\n';
        msg += '   🔄 ' + entry.simultaneousLimit + ' | ⏱️ ' + entry.maxTime + 's\n';
        msg += '   🕐 ' + lastAttackTime + '\n\n';
    });
    
    const totalAttacks = rankingData.reduce((sum, r) => sum + r.total_attacks, 0);
    const totalQuedas = rankingData.reduce((sum, r) => sum + r.total_quedas, 0);
    
    msg += '━━━━━━━━━━━━━━━━━━━━\n';
    msg += '👥 ' + rankingData.length + ' VIPs\n';
    msg += '⚔️ ' + totalAttacks + ' ataques\n';
    msg += '💀 ' + totalQuedas + ' quedas';
    
    await ctx.replyWithHTML(msg);
});


bot.command('status', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!checkCaptcha(userId)) {
        await showCaptcha(ctx, userId);
        return;
    }
    
    const user = authorizedUsers.get(userId);
    if (!user) return ctx.reply('❌ ACESSO NEGADO');
    
    const history = userAttackHistory.get(userId);
    const totalAttacks = history ? history.total_attacks : 0;
    const totalQuedas = history ? history.total_quedas : 0;
    
    let ativos = 0;
    const userAttackSet = userAttacks.get(userId);
    if (userAttackSet) {
        for (const attackId of userAttackSet) {
            const attack = activeAttacks.get(attackId);
            if (attack && attack.status === 'EXECUTANDO') ativos++;
        }
    }
    
    const isVip = user.vip || vipUsers.has(userId);
    const vipRemaining = getVipRemaining(userId);
    
    await ctx.replyWithHTML(
        `📊 <b>MEU STATUS</b>\n\n` +
        `👤 ${escapeMarkdown(ctx.from.first_name)}\n` +
        `💠 ${user.patente || 'FREE'}\n` +
        `⭐ VIP: ${isVip ? '✅' : '❌'}\n` +
        (isVip && vipRemaining > 0 ? `⏳ ${formatVipRemaining(vipRemaining)}\n` : '') +
        `⚔️ Ataques: ${totalAttacks}\n` +
        `💀 Quedas: ${totalQuedas}\n` +
        `🔥 Ativos: ${ativos}\n` +
        `🔄 Max: ${user.simultaneousLimit || 1}\n` +
        `⏱️ Max: ${user.maxTime || 30}s`
    );
});


