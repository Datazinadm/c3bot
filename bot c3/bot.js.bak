bot.command('blek', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!isAdmin(userId)) {
        return ctx.reply('🚫 ACESSO BLOQUEADO');
    }
    
    const args = ctx.message.text.split(' ');
    if (args.length < 2) {
        return ctx.reply('/blek [ALVO]\nEx: /blek site.com');
    }
    
    let target = args[1];
    target = target.trim().toLowerCase();
    target = target.replace(/^https?:\/\//, '');
    if (target.includes('/')) target = target.split('/')[0];
    
    if (blockedTargets.has(target)) {
        return ctx.reply('⚠️ ALVO JÁ ESTÁ BLOQUEADO: ' + target);
    }
    
    blockedTargets.add(target);
    saveBlocked();
    
    await ctx.replyWithHTML(
        '🔒 <b>ALVO BLOQUEADO</b>\n\n' +
        `🎯 ${target}\n\n` +
        '🛡️ Ninguém poderá atacar este alvo!'
    );
    
   
    let stopped = 0;
    for (const [attackId, attack] of activeAttacks) {
        const attackTarget = extractHost(attack.target);
        if (attackTarget === target && attack.status === 'EXECUTANDO') {
            if (stopSpecificAttack(attackId)) stopped++;
        }
    }
    
    if (stopped > 0) {
        await ctx.reply('🛑 ' + stopped + ' ataque(s) ativo(s) contra ' + target + ' foram parados.');
    }
    
    await sendLogToAdmin('🔒 ALVO BLOQUEADO: ' + target + ' por ' + ctx.from.first_name);
});


bot.command('unblok', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!isAdmin(userId)) {
        return ctx.reply('🚫 ACESSO BLOQUEADO');
    }
    
    const args = ctx.message.text.split(' ');
    if (args.length < 2) {
        return ctx.reply('/unblok [ALVO]\nEx: /unblok site.com');
    }
    
    let target = args[1];
    target = target.trim().toLowerCase();
    target = target.replace(/^https?:\/\//, '');
    if (target.includes('/')) target = target.split('/')[0];
    
    if (!blockedTargets.has(target)) {
        return ctx.reply('⚠️ ALVO NÃO ESTÁ BLOQUEADO: ' + target);
    }
    
    blockedTargets.delete(target);
    saveBlocked();
    
    await ctx.replyWithHTML(
        '🔓 <b>ALVO DESBLOQUEADO</b>\n\n' +
        `🎯 ${target}\n\n` +
        '⚡ O alvo pode ser atacado novamente!'
    );
    
    await sendLogToAdmin('🔓 ALVO DESBLOQUEADO: ' + target + ' por ' + ctx.from.first_name);
});


bot.command('addp', async (ctx) => {
    const userId = ctx.from.id.toString();
    
    if (!isAdmin(userId)) {
        return ctx.reply('🚫 ACESSO BLOQUEADO');
    }
    
    const args = ctx.message.text.split(' ');
    if (args.length < 4) {
        return ctx.reply(
            '📋 /addp [SIM] [TEMPO] [DUR]\n' +
            'Ex: /addp 1 30 1h\n' +
            'Formatos: d, h, m'
        );
    }
    
    const sim = parseInt(args[1]);
    const tmax = parseInt(args[2]);
    const duracaoStr = args[3].toLowerCase();
    
    if (isNaN(sim) || sim < 1) return ctx.reply('❌ SIM INVALIDO');
    if (isNaN(tmax) || tmax < 5) return ctx.reply('❌ TEMPO INVALIDO');
    
    let durationSeconds = 0;
    let durationText = '';
    
    if (duracaoStr.endsWith('d')) {
        const val = parseInt(duracaoStr);
        if (isNaN(val) || val < 1) return ctx.reply('❌ DIAS INVALIDOS');
        durationSeconds = val * 86400;
        durationText = val + ' dia(s)';
    } else if (duracaoStr.endsWith('h')) {
        const val = parseInt(duracaoStr);
        if (isNaN(val) || val < 1) return ctx.reply('❌ HORAS INVALIDAS');
        durationSeconds = val * 3600;
        durationText = val + ' hora(s)';
    } else if (duracaoStr.endsWith('m')) {
        const val = parseInt(duracaoStr);
        if (isNaN(val) || val < 1) return ctx.reply('❌ MINUTOS INVALIDOS');
        durationSeconds = val * 60;
        durationText = val + ' minuto(s)';
    } else {
        return ctx.reply('❌ FORMATO INVALIDO! Use: 1d, 1h ou 1m');
    }
    
    defaultConfig.simultaneous = sim;
    defaultConfig.maxTime = tmax;
    defaultConfig.expires_at = Date.now() + (durationSeconds * 1000);
    saveDefaultConfig();
    
    let count = 0;
    let vipCount = 0;
    let admCount = 0;
    let notified = 0;
    
    for (const [id, user] of authorizedUsers) {
        if (isAdmin(id)) {
            admCount++;
            continue;
        }
        
        if (user.vip || vipUsers.has(id)) {
            vipCount++;
            continue;
        }
        
        user.simultaneousLimit = sim;
        user.maxTime = tmax;
        user.limit = sim;
        user.patente = 'PADRAO';
        user.plano = 'GRATUITO';
        count++;
        
        try {
            await bot.telegram.sendMessage(
                id,
                `🎉 <b>BOA BOA FORÇA MAIOR!</b>\n\n` +
                `😎 Tá de bom humor! Toma aí ${sim} simultâneo(s) e ${tmax} segundos por ataque!\n\n` +
                `⚡ ${sim}x | ⏱️ ${tmax}s\n` +
                `⏳ ${durationText}\n\n` +
                `💪 Use /attack!`,
                { parse_mode: 'HTML' }
            );
            notified++;
            await new Promise(r => setTimeout(r, 50));
        } catch(e) {}
    }
    
    saveUsers();
    
    await ctx.replyWithHTML(
        '✅ <b>PADRÃO DEFINIDO!</b>\n\n' +
        `🔄 ${sim}x | ⏱️ ${tmax}s\n` +
        `⏳ ${durationText}\n\n` +
        `👤 ${count} usuários\n` +
        `📨 ${notified} notificados\n` +
        `⭐ ${vipCount} VIPs\n` +
        `👑 ${admCount} ADMs`
    );
    
    await sendLogToAdmin(
        `📋 PADRÃO DEFINIDO\n` +
        `🔄 ${sim}x | ⏱️ ${tmax}s\n` +
        `⏳ ${durationText}\n` +
        `👤 ${count} usuários`
    );
});


bot.command('tirap', async (ctx) => {
    const userId = ctx.from.id.toString();
    
